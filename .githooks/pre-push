#!/usr/bin/env sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

case "${PREFIX:-}" in
  /data/data/com.termux/files/usr*)
    printf '%s\n' "JB Expert QA: Termux detected; running Android-compatible tests..."
    npm run test:mobile
    ;;
  *)
    printf '%s\n' "JB Expert QA: running all engine tests before push..."
    npm run test:all-engines
    ;;
esac

printf '%s\n' "JB Expert QA: pre-push validation passed."
