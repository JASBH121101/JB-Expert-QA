{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jb:security-guard:rate-limit:check-request:v1",
  "title": "JB Security Guard rate-limit check request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "tenantId",
    "applicationId",
    "policyId",
    "scope",
    "identity"
  ],
  "properties": {
    "schema": {
      "const": "jb.security.rate-limit.check/v1"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "keyId"
      ],
      "properties": {
        "type": {
          "enum": [
            "ip",
            "account",
            "account_ip",
            "session",
            "anonymous"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]{1,64}$"
        }
      }
    }
  }
}
