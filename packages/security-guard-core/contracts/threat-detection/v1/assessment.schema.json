{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jb:security-guard:threat-assessment:v1",
  "title": "JB Security Guard threat assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessmentId",
    "tenantId",
    "applicationId",
    "assessedAtMs",
    "riskScore",
    "decision",
    "signalIds",
    "policyId"
  ],
  "properties": {
    "schema": {
      "const": "jb.security.threat-assessment/v1"
    },
    "assessmentId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "assessedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "decision": {
      "enum": [
        "observe",
        "challenge",
        "block",
        "review"
      ]
    },
    "signalIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "policyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    }
  }
}
