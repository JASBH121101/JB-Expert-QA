{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jb:security-guard:threat-signal:v1",
  "title": "JB Security Guard threat signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "signalId",
    "tenantId",
    "applicationId",
    "detectedAtMs",
    "source",
    "type",
    "confidence",
    "severity",
    "ruleId"
  ],
  "properties": {
    "schema": {
      "const": "jb.security.threat-signal/v1"
    },
    "signalId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,96}$"
    },
    "detectedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "type": {
      "enum": [
        "brute_force",
        "endpoint_scan",
        "enumeration",
        "sql_injection",
        "parameter_tampering",
        "api_abuse",
        "bot_traffic",
        "anomaly",
        "upload_risk"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,95}$"
    },
    "subjectKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routeTemplate": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9_./:{}*-]*$"
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
