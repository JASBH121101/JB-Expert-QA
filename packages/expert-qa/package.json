{
  "name": "@jb/expert-qa",
  "version": "0.2.0",
  "description": "Complete local-first web project quality, security, browser, accessibility and visual QA engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jb-qa": "./cli/package-cli.js",
    "jb-qa-project": "./src/project-cli.js",
    "jb-qa-url": "./src/cli.js",
    "jb-qa-security": "./src/security-cli.js",
    "jb-qa-security-url": "./src/security-url-cli.js",
    "jb-qa-autopilot": "./src/autopilot-cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./cli": "./cli/package-cli.js",
    "./browser": "./src/adapters/playwright/audit-url.js",
    "./visual": "./src/adapters/visual/png-diff.js",
    "./ai": "./src/ai/provider-router.js",
    "./autopilot": "./src/agent/autopilot.js",
    "./security-bridge": "./src/security-bridge/index.js",
    "./version": "./package-version.js"
  },
  "files": [
    "src/**",
    "cli/**",
    "config/**",
    "package-version.js",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-expert-qa-package.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test ./package-tests/complete-engine.spec.js ./package-tests/browser-audit.spec.js",
    "setup:browser": "node cli/package-cli.js setup --browser chromium"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JASBH121101/JB-Expert-QA.git",
    "directory": "packages/expert-qa"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
