{
  "name": "@jb/expert-qa",
  "version": "0.2.0",
  "description": "Complete local-first web project quality, security, performance, browser, accessibility and visual QA engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jb-qa": "./cli/package-cli.js",
    "jb-qa-project": "./src/project-cli.js",
    "jb-qa-url": "./src/cli.js",
    "jb-qa-security": "./src/security-cli.js",
    "jb-qa-security-url": "./src/security-url-cli.js",
    "jb-qa-autopilot": "./src/autopilot-cli.js",
    "jb-qa-db": "./src/database-cli.js",
    "jb-qa-dashboard": "./src/dashboard-cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./audit-engines": "./src/audit-engines/index.js",
    "./dashboard": "./src/dashboard/server.js",
    "./cli": "./cli/package-cli.js",
    "./browser": "./src/adapters/playwright/audit-url.js",
    "./visual": "./src/adapters/visual/png-diff.js",
    "./ai": "./src/ai/provider-router.js",
    "./autopilot": "./src/agent/autopilot.js",
    "./autonomous-execution": "./src/agent/autonomous-execution.js",
    "./security-bridge": "./src/security-bridge/index.js",
    "./version": "./package-version.js",
    "./database": "./src/adapters/filesystem/audit-database.js",
    "./engine-registry": "./src/engine-registry/index.js",
    "./api-testing-adapter": "./src/engine-registry/adapters/api-testing.js",
    "./engine-orchestrator": "./src/engine-registry/orchestrator.js",
    "./static-qa-adapter": "./src/engine-registry/adapters/static-qa.js",
    "./static-security-qa-adapter": "./src/engine-registry/adapters/static-security-qa.js",
    "./runtime-security-qa-adapter": "./src/engine-registry/adapters/runtime-security-qa.js",
    "./accessibility-qa-adapter": "./src/engine-registry/adapters/accessibility-qa.js",
    "./performance-qa-adapter": "./src/engine-registry/adapters/performance-qa.js",
    "./visual-qa-adapter": "./src/engine-registry/adapters/visual-qa.js",
    "./report-certification-adapter": "./src/engine-registry/adapters/report-certification.js",
    "./dashboard-phase4-execution": "./src/dashboard/phase4-execution.js",
    "./dashboard-phase4-catalog": "./src/dashboard/phase4-catalog.js",
    "./execution-runtime": "./src/agent/execution-runtime.js",
    "./execution-job-queue": "./src/agent/execution-job-queue.js"
  },
  "files": [
    "src/**",
    "cli/**",
    "config/**",
    "package-version.js",
    "README.md",
    "packages/localization-engine/src/**",
    "packages/api-testing-engine/src/**"
  ],
  "scripts": {
    "setup:browser": "node cli/package-cli.js setup --browser chromium"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JASBH121101/JB-Expert-QA.git",
    "directory": "packages/expert-qa"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
